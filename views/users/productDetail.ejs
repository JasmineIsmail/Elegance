						<p class="stext-102 cl3 p-t-23">
							<%= productData.description %>
						</p>
						
						
							<div class="flex-w flex-r-m p-b-10">
								<div class="size-204 flex-w flex-m respon6-next flex-column">
									
									<button class="flex-c-m text-light stext-101 cl0 size-101 bg-secondary bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail m-t-10 mb-5">
										<a href="/addToCart?id=<%= productData._id %>" style="color: white;text-decoration: none;">Add to cart</a> 
									</button>
									<button 
										type="button"
										id="wishlistBtn"
										data-product-id="<%= productData._id %>"
										class="flex-c-m text-white stext-101 cl0 size-101 bg-secondary bor1 hov-btn1 p-lr-15 trans-04">
